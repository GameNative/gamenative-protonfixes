{
  "coverage": "full",
  "id": "950670",
  "name": "Gothic Playable Teaser",
  "schema": 1,
  "steps": [
    {
      "action": "mkdir",
      "op": "file",
      "to": "${install}/GothicRemake/Saved/Config/WindowsNoEditor"
    },
    {
      "action": "touch",
      "op": "file",
      "to": "${install}/GothicRemake/Saved/Config/WindowsNoEditor/Engine.ini"
    },
    {
      "backup": true,
      "createIfMissing": false,
      "op": "ini",
      "path": "${install}/GothicRemake/Saved/Config/WindowsNoEditor/Engine.ini",
      "section": "Core.Log",
      "values": {
        "Global": "off",
        "LogInteractiveProcess": "all off"
      }
    },
    {
      "backup": true,
      "createIfMissing": false,
      "op": "ini",
      "path": "${install}/GothicRemake/Saved/Config/WindowsNoEditor/Engine.ini",
      "section": "SystemSettings",
      "values": {
        "r.DefaultFeature.MotionBlur": "0",
        "r.DepthOfFieldQuality": "0",
        "r.LensFlareQuality": "0",
        "r.MotionBlur.Max": "0",
        "r.MotionBlurQuality": "0"
      }
    },
    {
      "action": "delete",
      "glob": true,
      "minSizeBytes": 11000000,
      "op": "file",
      "to": "${install}/GothicRemake/Saved/Logs/*.log"
    }
  ],
  "store": "steam",
  "upstream": "gamefixes-steam/950670.py",
  "upstreamCommit": "8854a7c"
}
